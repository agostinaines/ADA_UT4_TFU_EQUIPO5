        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();\r",
                  "\r",
                  "if (res.success && res.access_token) {\r",
                  "    pm.environment.set(\"accessToken\", res.access_token);\r",
                  "    pm.environment.set(\"rol\", res.rol)\r",
                  "    console.log(\"accessToken and role saved to environment\");\r",
                  "} else {\r",
                  "    console.log(\"Failed to extract accessToken or role\");\r",
                  "}"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
