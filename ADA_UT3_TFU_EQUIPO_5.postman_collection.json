            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const res = pm.response.json();\r\n\r\nif (res.success && res.access_token) {\r\n    pm.environment.set(\"accessToken\", res.access_token);\r\n    pm.environment.set(\"rol\", res.rol)\r\n    console.log(\"accessToken and role saved to environment\");\r\n} else {\r\n    console.log(\"Failed to extract accessToken or role\");\r\n}"
                ]
